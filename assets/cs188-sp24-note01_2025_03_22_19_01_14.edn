                                   :y2 898.640625,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}),
                          :page 1},
               :content {:text "he actuators and the sensors are the methods with which the agent acts on the environment and receives information from it"},
               :properties {:color "red"}}
              {:id #uuid "67e4ac2e-2191-4ab9-88d9-d2d6d9c00299",
               :page 1,
               :position {:bounding {:x1 150.03125,
