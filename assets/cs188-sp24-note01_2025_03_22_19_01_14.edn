                          :rects ({:x1 858.795654296875,
                                   :y1 712.3125,
                                   :x2 929.734130859375,
                                   :y2 732.3125,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}
                                  {:x1 150.03125,
