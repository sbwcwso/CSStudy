                                   :y2 853.5,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}),
                          :page 1},
               :content {:text "The performance measure describes what utility the agent tries to increase."},
               :properties {:color "yellow"}}
              {:id #uuid "67e4abcf-102c-4a79-bcd2-30297486b8d1",
               :page 1,
               :position {:bounding {:x1 150.03125,
                                     :y1 833.5,
                                     :x2 929.4375,
