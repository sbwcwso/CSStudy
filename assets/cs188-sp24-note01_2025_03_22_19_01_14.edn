                                   :y2 565.875,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}),
                          :page 1},
               :content {:text "In artificial intelligence, the central problem at hand is that of the creation of a rational agent, an entity that has goals or preferences and tries to perform a series of actions that yield the best/optimal expected outcome given these goals"},
               :properties {:color "red"}}
              {:id #uuid "67e4a07f-a910-402b-a92b-9d1803bd3e5e",
               :page 1,
               :position {:bounding {:x1 150.03125,
                                     :y1 545.875,
                                     :x2 929.975830078125,
                                     :y2 588.4375,
                                     :width 1019.9999999999999,
                                     :height 1319.9999999999998},
                          :rects ({:x1 289.1318054199219,
                                   :y1 545.875,
                                   :x2 929.975830078125,
                                   :y2 565.875,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}
                                  {:x1 150.03125,
                                   :y1 568.4375,
                                   :x2 850.84375,
                                   :y2 588.4375,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}),
                          :page 1},
               :content {:text "Rational agents exist in an environment, which is specific to the given instantiation of the agent. Agents use sensors to interact with the environment and act on it using actuators. "},
               :properties {:color "red"}}
              {:id #uuid "67e4a10a-602c-4f1a-95bd-5d8bab1f9e2c",
               :page 1,
               :position {:bounding {:x1 150.03125,
                                     :y1 613.578125,
                                     :x2 929.7276611328125,
                                     :y2 656.15625,
                                     :width 1019.9999999999999,
                                     :height 1319.9999999999998},
                          :rects ({:x1 479.31622314453125,
                                   :y1 613.578125,
                                   :x2 929.7276611328125,
                                   :y2 633.578125,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}
                                  {:x1 150.03125,
                                   :y1 636.15625,
                                   :x2 260.875,
                                   :y2 656.15625,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}),
                          :page 1},
               :content {:text "Together, an environment and the agents that reside within it create a world."},
               :properties {:color "red"}}
              {:id #uuid "67e4a131-49e9-4948-84a3-72b027642339",
               :page 1,
               :position {:bounding {:x1 150.03125,
                                     :y1 667.046875,
