                                   :y2 754.890625,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}),
                          :page 1},
               :content {:text "Then, the agent can determine hypothesized consequences of the actions and can select the best one"},
               :properties {:color "blue"}}
