                          :rects ({:x1 484.5077209472656,
                                   :y1 689.75,
                                   :x2 930.5,
                                   :y2 709.75,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}
                                  {:x1 150.03125,
                                   :y1 712.3125,
                                   :x2 854.4512939453125,
                                   :y2 732.3125,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}),
                          :page 1},
               :content {:text "These agents are typically outperformed by planning agents, which maintain a model of the world and use this model to simulate performing various actions."},
               :properties {:color "yellow"}}
              {:id #uuid "67e4a2a6-d672-49dc-8387-e2c1f9918f80",
