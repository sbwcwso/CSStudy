                                     :y2 709.75,
                                     :width 1019.9999999999999,
                                     :height 1319.9999999999998},
                          :rects ({:x1 150.03125,
                                   :y1 667.046875,
                                   :x2 930.0253295898438,
                                   :y2 687.046875,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}
                                  {:x1 150.03125,
                                   :y1 689.75,
                                   :x2 480.2720642089844,
                                   :y2 709.75,
                                   :width 1019.9999999999999,
                                   :height 1319.9999999999998}),
                          :page 1},
               :content {:text "A reflex agent is one that doesn’t think about the consequences of its actions, but rather selects an action based solely on the current state of the world."},
               :properties {:color "red"}}
              {:id #uuid "67e4a1ab-0409-4e3b-a3ca-10b09975453c",
               :page 1,
